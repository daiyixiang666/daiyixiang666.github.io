---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { site } from '../site';
interface Props { title?: string; description?: string; image?: string; type?: 'website' | 'article'; }
const { title = site.title, description = site.description, image = '/covers/latent.svg', type = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const section = Astro.url.pathname.startsWith('/about') ? 'about' : 'posts';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8fa" />
    <title>{title === site.title ? title : `${title} · ${site.title}`}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header container">
      <a href="/" class="wordmark" aria-label="Yixiang Notes 首页">Yixiang <span>/</span> Notes<span class="wordmark-dot">.</span></a>
      <nav aria-label="主导航">
        <a href="/" aria-current={section === 'posts' ? 'page' : undefined}>文章</a>
        <a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>关于</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer container">
      <span>© {new Date().getUTCFullYear()} {site.author}. 记录理解的过程。</span>
      <div><a href="/rss.xml">RSS ↗</a><a href="https://github.com/daiyixiang666/daiyixiang666.github.io">网站源码 ↗</a><a href="#top" aria-label="回到顶部">↑</a></div>
    </footer>
  </body>
</html>
