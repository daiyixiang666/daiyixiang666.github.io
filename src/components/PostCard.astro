---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../site';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const url = `/posts/${post.id}/`;
---
<article class="post-card" data-category={post.data.category}>
  <a href={url} class="cover-link" tabindex="-1" aria-hidden="true">
    <img src={post.data.cover} alt="" width="720" height="440" loading="lazy" />
    <span class="cover-label">{post.data.category}</span>
  </a>
  <div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readingTime(post.body)} 分钟阅读</span>{post.data.sample && <span class="sample-label">示例文章</span>}</div>
  <h2><a href={url}>{post.data.title}</a></h2>
  <p>{post.data.description}</p>
  <a href={url} class="read-link" aria-label={`阅读：${post.data.title}`}>阅读全文 <span aria-hidden="true">↗</span></a>
</article>
